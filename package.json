{
  "name": "@altegio/integrations-hub-mcp",
  "version": "0.1.0",
  "description": "MCP server for automated Altegio Integrations Hub application lifecycle management",
  "type": "module",
  "private": true,
  "bin": {
    "altegio-integrations-hub-mcp": "dist/index.js",
    "altegio-integrations-hub-mcp-http": "dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-server.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
