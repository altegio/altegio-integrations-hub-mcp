{
  "name": "@altegio/integrations-hub-mcp",
  "version": "0.1.0",
  "description": "MCP server for automated Altegio Integrations Hub application lifecycle management",
  "type": "module",
  "private": true,
  "bin": {
    "altegio-integrations-hub-mcp": "dist/index.js",
    "altegio-integrations-hub-mcp-http": "dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-server.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run catalog:check && npm run test:package",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build",
    "catalog": "npm run build && node scripts/catalog.mjs",
    "catalog:check": "node scripts/catalog.mjs --check",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  },
  "engines": {
    "node": "^24.22.2 || ^26.13.0",
    "npm": ">=12.2.2 <13"
  },
  "packageManager": "npm@12.2.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altegio/altegio-integrations-hub-mcp.git"
  },
  "homepage": "https://github.com/altegio/altegio-integrations-hub-mcp#readme",
  "bugs": {
    "url": "https://github.com/altegio/altegio-integrations-hub-mcp/issues"
  },
  "files": [
    "dist",
    "docs/marketplace-internals.md",
    "docs/embedded-surfaces.md",
    "docs/safe-e2e.md",
    "docs/tool-boundaries.md",
    "docs/webhooks.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./http": {
      "types": "./dist/http-server.d.ts",
      "import": "./dist/http-server.js"
    }
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
